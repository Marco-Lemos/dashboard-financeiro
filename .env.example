# URL de conexão Postgres do Supabase (use a connection string do "Connection Pooler",
# modo "Transaction", porta 6543 — é a indicada para ambiente serverless/Vercel).
# Painel do projeto: Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# URL e chave anônima/publishable do projeto Supabase (usadas pelo SERVIDOR para
# validar o token de quem está logado). Painel: Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Mesmas informações, expostas para o FRONTEND (prefixo VITE_ é obrigatório
# para o Vite incluir a variável no build do navegador)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

NODE_ENV=development
